# Customer Acquisition OS — environment template
# Copy to .env.local for development. Never commit secrets.
# Production secrets live in the cloud secrets manager (Platform + Security).

# Runtime
NODE_ENV=development
APP_URL=http://localhost:5173
MARKETING_URL=http://localhost:5174
API_URL=http://localhost:3001
API_PORT=3001
CORS_ORIGIN=http://localhost:5173

# Database (Sprint 2+) — Managed Postgres in production
# DATABASE_URL=postgresql://user:pass@localhost:5432/acquisition_os
# Without DATABASE_URL, API uses embedded PGlite (dev/test only)

# Session (Sprint 1+) — generate via secrets manager; never commit real values
SESSION_PEPPER=replace-with-long-random-dev-pepper
# BCRYPT_COST=12
# SESSION_TTL_HOURS=12

# Redis / queue (Sprint 4+)
# REDIS_URL=
# QUEUE_URL=

# Observability
LOG_LEVEL=info
